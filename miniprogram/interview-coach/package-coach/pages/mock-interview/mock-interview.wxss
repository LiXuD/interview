.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.chat-message {
  margin-bottom: 24rpx;
  display: flex;
}

.chat-message.assistant {
  justify-content: flex-start;
}

.chat-message.user {
  justify-content: flex-end;
}

.msg-bubble {
  max-width: 80%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.chat-message.assistant .msg-bubble {
  background-color: #f0f0f0;
  color: #333;
  border-bottom-left-radius: 4rpx;
}

.chat-message.user .msg-bubble {
  background-color: #1a1a2e;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.input-area {
  background-color: #fff;
  border-top: 1rpx solid #eee;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.turns-info {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-bottom: 12rpx;
}

.input-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.chat-input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  max-height: 200rpx;
}

.send-btn {
  background-color: #1a1a2e;
  color: #fff;
  border: none;
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  min-width: 100rpx;
}

.send-btn[disabled] {
  background-color: #999;
}

.btn-finish {
  margin-top: 12rpx;
  background: none;
  border: 1rpx solid #e74c3c;
  color: #e74c3c;
  border-radius: 12rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  width: 100%;
}

.dim-name { width: 180rpx; }
