.provider-card { padding: 24rpx 32rpx; }
.provider-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.provider-name { font-size: 30rpx; font-weight: 600; color: #1a1a2e; }
.default-tag { font-size: 20rpx; background-color: #e8f5e9; color: #2e7d32; padding: 4rpx 12rpx; border-radius: 12rpx; }
.provider-meta { font-size: 24rpx; margin-bottom: 16rpx; }
.provider-actions { display: flex; gap: 16rpx; }
.btn-sm { font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 8rpx; background-color: #f0f0f0; color: #333; border: none; min-height: auto; line-height: 1.5; }
.btn-danger { background-color: #fff3f3; color: #e74c3c; }

.create-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.create-sheet {
  width: 100%;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
}
.sheet-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx; }
.sheet-title { font-size: 34rpx; font-weight: 600; color: #1a1a2e; }
.sheet-close { font-size: 28rpx; color: #999; }

.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; margin-bottom: 8rpx; display: block; }
.form-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.picker-value { color: #333; }

.test-result { font-size: 26rpx; padding: 16rpx; border-radius: 8rpx; margin-bottom: 24rpx; }
.test-ok { background-color: #e8f5e9; color: #2e7d32; }
.test-fail { background-color: #fff3f3; color: #e74c3c; }

.form-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.form-actions .btn-sm { flex: 1; text-align: center; padding: 20rpx 0; }
.form-actions .btn-primary { flex: 2; }
