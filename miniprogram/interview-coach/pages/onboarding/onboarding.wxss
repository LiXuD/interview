.onboarding {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}

.swiper {
  flex: 1;
}

.page-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx 40rpx;
  height: 100%;
  box-sizing: border-box;
}

.page-icon {
  font-size: 96rpx;
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.step-list {
  width: 100%;
  padding: 0 16rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.step-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #27ae60;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.step-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #ddd;
  transition: all 0.3s;
}

.dot-active {
  width: 40rpx;
  background: #1a1a2e;
}

.bottom-actions {
  padding: 0 48rpx 80rpx;
  text-align: center;
}

.skip-link {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #999;
}
