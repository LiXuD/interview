.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #1a1a2e;
}

.login-header {
  padding: 200rpx 60rpx 80rpx;
  text-align: center;
}

.app-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.app-subtitle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
}

.login-body {
  flex: 1;
  background-color: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 60rpx 48rpx;
}
