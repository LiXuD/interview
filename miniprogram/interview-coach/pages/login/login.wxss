.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #1a1a2e;
}

.login-header {
  padding: 200rpx 60rpx 80rpx;
  text-align: center;
}

.app-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.app-subtitle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
}

.login-body {
  flex: 1;
  background-color: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 60rpx 48rpx;
}

.dev-login-section {
  margin-top: 60rpx;
}

.dev-divider {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-bottom: 32rpx;
  position: relative;
}

.dev-divider::before,
.dev-divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 30%;
  height: 1rpx;
  background-color: #ddd;
}

.dev-divider::before {
  left: 0;
}

.dev-divider::after {
  right: 0;
}

.dev-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.btn-dev {
  background-color: #f0f0f0;
  color: #333;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  border: none;
  width: 100%;
}

.btn-dev[disabled] {
  background-color: #f5f5f5;
  color: #ccc;
}
