<view class="container">
  <view wx:if="{{error}}" class="error-banner">{{error}}</view>
  <view wx:if="{{loading}}" class="loading-mask"><view>加载中...</view></view>

  <view wx:elif="{{data}}">
    <view class="card">
      <view class="section-title">能力维度概览</view>
      <view wx:for="{{data.dimensions}}" wx:key="name" class="dimension-row">
        <view class="dim-name">{{item.name}}</view>
        <view class="dim-bar">
          <view class="dim-fill" style="width: {{item.score}}%"></view>
        </view>
        <view class="dim-score">{{item.score}}</view>
      </view>
    </view>

    <view class="card" wx:if="{{data.strengths.length > 0}}">
      <view class="section-title">优势维度</view>
      <view wx:for="{{data.strengths}}" wx:key="*this" class="list-item strength">{{item}}</view>
    </view>

    <view class="card" wx:if="{{data.weaknesses.length > 0}}">
      <view class="section-title">待提升维度</view>
      <view wx:for="{{data.weaknesses}}" wx:key="*this" class="list-item weakness">{{item}}</view>
    </view>

    <view class="card" wx:if="{{data.nextFocus.length > 0}}">
      <view class="section-title">建议重点</view>
      <view wx:for="{{data.nextFocus}}" wx:key="*this" class="list-item">{{item}}</view>
    </view>
  </view>
</view>
