.day-group {
  margin-bottom: 32rpx;
}

.day-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.task-card {
  cursor: pointer;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.task-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.task-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.status-pending { background-color: #f5f5f5; color: #999; }
.status-in_progress { background-color: #e3f2fd; color: #1565c0; }
.status-completed { background-color: #e8f5e9; color: #2e7d32; }

.task-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.btn-go-mock {
  margin-top: 32rpx;
  background-color: #1a1a2e;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  border: none;
  width: 100%;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-body {
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx;
  max-height: 85vh;
  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.answer-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.feedback-card {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.feedback-score {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.feedback-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.feedback-section {
  margin-top: 16rpx;
}

.feedback-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.feedback-item {
  font-size: 26rpx;
  color: #333;
  padding: 8rpx 0;
  line-height: 1.5;
}
