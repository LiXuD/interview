.page {
  min-height: 100vh;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.6;
}

.jd-text {
  white-space: pre-wrap;
  word-break: break-all;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-row .btn-primary,
.action-row .btn-outline,
.action-row .btn-danger {
  flex: 1;
}

.flow-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.flow-grid button {
  width: 100%;
  margin: 0;
  font-size: 26rpx;
  padding: 18rpx 0;
}

.btn-outline {
  background: #fff;
  color: #1a1a2e;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.btn-danger {
  background: #e74c3c;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

/* form styles are in app.wxss */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.modal-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-actions button {
  flex: 1;
}
