<view class="container">
  <view wx:if="{{error}}" class="error-banner">{{error}}</view>

  <view class="section-title">账号</view>
  <view class="card">
    <view class="setting-row">
      <view class="setting-label">用户名</view>
      <view class="setting-value">{{username}}</view>
    </view>
    <view class="setting-row">
      <view class="setting-label">用户 ID</view>
      <view class="setting-value text-muted" style="font-size: 22rpx;">{{userId}}</view>
    </view>
  </view>

  <view class="section-title">健康检查</view>
  <view class="card">
    <view class="setting-row" bindtap="checkHealth">
      <view class="setting-label">后端连接状态</view>
      <view class="setting-value" style="color: {{healthOk ? '#27ae60' : '#e74c3c'}};">
        {{healthStatus}}
      </view>
    </view>
  </view>

  <view class="section-title">关于</view>
  <view class="card">
    <view class="setting-row">
      <view class="setting-label">版本</view>
      <view class="setting-value text-muted">0.1.0 (MVP)</view>
    </view>
    <view class="setting-row" bindtap="goPrivacy">
      <view class="setting-label">隐私政策</view>
      <view class="setting-value">></view>
    </view>
  </view>

  <button class="btn-logout" bindtap="onLogout">退出登录</button>

  <button class="btn-delete" bindtap="onDeleteAccount">删除账号</button>

  <!-- 删除确认弹窗 -->
  <view wx:if="{{showDeleteConfirm}}" class="modal-mask" bindtap="onCancelDelete">
    <view class="modal-body" catchtap>
      <view class="modal-title">最终确认</view>
      <view class="modal-desc">确定要删除账号吗？此操作不可撤销。</view>
      <checkbox-group bindchange="onDeleteMemoryChange" class="delete-memory-option">
        <label class="consent-label">
          <checkbox value="delete" checked="{{deleteLocalMemory}}" color="#e74c3c" />
          <text class="consent-text">同时删除本机教练记忆归档（默认保留）</text>
        </label>
      </checkbox-group>
      <view class="delete-actions">
        <button class="btn-cancel" bindtap="onCancelDelete">取消</button>
        <button class="btn-confirm-delete" bindtap="onConfirmDelete">确认删除</button>
      </view>
    </view>
  </view>
</view>
