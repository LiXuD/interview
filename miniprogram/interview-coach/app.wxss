/**
 * 全局样式。
 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

.container {
  padding: 32rpx;
}

.btn-primary {
  background-color: #1a1a2e;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  border: none;
  width: 100%;
}

.btn-primary[disabled] {
  background-color: #999;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  color: #999;
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
  text-align: center;
}

.loading-mask {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  color: #999;
}

.error-banner {
  background-color: #fff3f3;
  color: #e74c3c;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

/* 维度条 */
.dimension-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.dimension-row:last-child { border-bottom: none; }
.dim-name { width: 200rpx; font-size: 26rpx; color: #333; }
.dim-bar { flex: 1; height: 12rpx; background-color: #e0e0e0; border-radius: 6rpx; margin: 0 16rpx; overflow: hidden; }
.dim-fill { height: 100%; background-color: #3949ab; border-radius: 6rpx; }
.dim-score { width: 60rpx; text-align: right; font-size: 26rpx; font-weight: 600; color: #1a1a2e; }

/* 评分展示 */
.result-header { text-align: center; padding: 48rpx 32rpx; }
.score-circle { font-size: 80rpx; font-weight: 700; color: #1a1a2e; }
.score-label { font-size: 28rpx; color: #999; margin-top: 8rpx; }

/* 列表项 */
.list-item { padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx; color: #333; }
.list-item:last-child { border-bottom: none; }
.strength { color: #27ae60; }
.weakness { color: #e74c3c; }

/* 内容文本 */
.content-text { font-size: 28rpx; color: #333; line-height: 1.6; }
