<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'tab-active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon">{{index === 0 ? '🎯' : '⚙️'}}</view>
    <view class="tab-label">{{item.text}}</view>
  </view>
</view>
