# Backend local environment template.
# Copy to backend/.env for local runs and replace every value marked CHANGE_ME.
#
# Generate secrets with:
#   openssl rand -base64 32

IC_DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
IC_JWT_SECRET=CHANGE_ME_BASE64_32_BYTE_SECRET
IC_AI_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_SECRET

# Development login is intended for local smoke tests only.
IC_DEV_LOGIN_ENABLED=false

# Platform AI is optional for non-live unit tests. Enable only with real values.
IC_PLATFORM_AI_ENABLED=false
IC_PLATFORM_AI_BASE_URL=
IC_PLATFORM_AI_API_KEY=
IC_PLATFORM_AI_MODEL=
IC_PLATFORM_AI_MODE=chatCompletions

IC_SPRING_AI_ENABLED=false
IC_REQUIRE_REAL_AI_FOR_COACHING=true
